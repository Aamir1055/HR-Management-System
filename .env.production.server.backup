# PayRoll Management System - Production Environment Configuration
# Copy this file to .env and update the values for your production environment

# ===== DATABASE CONFIGURATION =====
# MySQL database connection details
DB_HOST=your-production-db-host
DB_USER=your-production-db-user
DB_PASSWORD=your-secure-db-password
DB_NAME=payroll_production

# ===== SECURITY CONFIGURATION =====
# JWT Secret - Generate a strong, unique key for production
# Generate using: openssl rand -base64 64
JWT_SECRET=your-super-secure-jwt-secret-key-min-32-characters-long

# ===== SERVER CONFIGURATION =====
# Backend server port
PORT=5000

# Environment setting
NODE_ENV=production

# ===== FRONTEND CONFIGURATION =====
# Primary frontend URL for CORS
FRONTEND_URL=https://your-domain.com

# Additional CORS origins (comma-separated)
# Include all domains that will access your API
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Vite dev server port (for development CORS)
VITE_PORT=5173

# ===== FEATURES =====
# Enable/disable half-day shift feature
HALF_DAY_FEATURE_ENABLED=true

# ===== RATE LIMITING =====
# Rate limiting window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=1000

# ===== FILE UPLOAD =====
# Upload directory path (relative to backend folder)
UPLOAD_PATH=uploads

# Maximum file size in bytes (5MB = 5242880)
MAX_FILE_SIZE=5242880

# ===== LOGGING =====
# Log level for production
LOG_LEVEL=info

# ===== PERFORMANCE =====
# Database connection pool settings
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# ===== EMAIL CONFIGURATION (if needed) =====
# SMTP settings for notifications
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@your-domain.com

# ===== BACKUP CONFIGURATION (optional) =====
# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ===== MONITORING =====
# Health check endpoint configuration
HEALTH_CHECK_ENABLED=true

# ===== SSL/TLS =====
# SSL certificate paths (if using HTTPS)
# SSL_KEY_PATH=/path/to/private-key.pem
# SSL_CERT_PATH=/path/to/certificate.pem

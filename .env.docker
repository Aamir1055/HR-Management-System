# Docker Compose Environment Variables for PayRoll Management System
# Copy this file to .env when deploying with Docker Compose

# ===== DATABASE CONFIGURATION =====
DB_ROOT_PASSWORD=secure_root_password_change_me
DB_USER=payroll_user
DB_PASSWORD=secure_database_password_change_me
DB_NAME=payroll_system
DB_PORT=3306

# ===== SECURITY =====
JWT_SECRET=your-super-secure-jwt-secret-key-must-be-at-least-32-characters-long-change-me

# ===== SERVER PORTS =====
BACKEND_PORT=5000
FRONTEND_PORT=80

# ===== FRONTEND CONFIGURATION =====
FRONTEND_URL=http://localhost
FRONTEND_DOMAIN=payroll.local
CORS_ORIGINS=http://localhost,http://localhost:80

# ===== BACKEND CONFIGURATION =====
BACKEND_DOMAIN=api.payroll.local
VITE_API_BASE_URL=http://localhost:5000
VITE_BACKEND_PORT=5000

# ===== FEATURES =====
HALF_DAY_FEATURE_ENABLED=true

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ===== FILE UPLOAD =====
MAX_FILE_SIZE=5242880

# ===== REDIS (OPTIONAL) =====
REDIS_PASSWORD=redis_password_change_me
REDIS_PORT=6379

# ===== SSL/TRAEFIK (OPTIONAL) =====
ACME_EMAIL=admin@your-domain.com

# ===== MONITORING (OPTIONAL) =====
GRAFANA_PASSWORD=secure_grafana_password

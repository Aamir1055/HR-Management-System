# AUTOMATED DUTY HOURS CONFIGURATION
# Enable this to use strict duty hours calculation
AUTOMATED_DUTY_HOURS_ENABLED=true

# Legacy half-day features (keep enabled for compatibility)
HALF_DAY_FEATURE_ENABLED=true

# Database Configuration
DB_HOST=localhost
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
DB_PORT=3306

# Application Configuration
PORT=5000
NODE_ENV=development

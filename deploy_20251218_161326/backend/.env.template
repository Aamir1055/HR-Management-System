# PayRoll Management System - Backend Environment Template
# Copy this file to .env and update the values for your environment

# ===== DATABASE CONFIGURATION =====
# MySQL database connection details - REQUIRED
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=payroll_system2
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ===== SECURITY CONFIGURATION =====
# JWT Secret - REQUIRED (minimum 32 characters)
# Generate using: openssl rand -base64 64
JWT_SECRET=your-super-secure-jwt-secret-key-must-be-at-least-32-characters-long

# ===== SERVER CONFIGURATION =====
# Backend server port - REQUIRED (NO FALLBACK)
PORT=5000

# Environment setting
NODE_ENV=development

# ===== FRONTEND CONFIGURATION =====
# Primary frontend URL for CORS - REQUIRED
FRONTEND_URL=http://localhost:3000

# Additional CORS origins (comma-separated) - OPTIONAL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== FEATURES =====
# Enable/disable half-day shift feature
HALF_DAY_FEATURE_ENABLED=true

# ===== RATE LIMITING =====
# Rate limiting window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=1000

# ===== FILE UPLOAD =====
# Upload directory path (relative to backend folder)
UPLOAD_PATH=uploads

# Maximum file size in bytes (5MB = 5242880)
MAX_FILE_SIZE=5242880

# ===== LOGGING =====
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ===== EMAIL CONFIGURATION (OPTIONAL) =====
# SMTP settings for notifications
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@your-domain.com

# ===== BACKUP CONFIGURATION (OPTIONAL) =====
# Database backup settings
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# ===== MONITORING =====
# Health check endpoint configuration
HEALTH_CHECK_ENABLED=true

# ===== SSL/TLS (PRODUCTION ONLY) =====
# SSL certificate paths (if using HTTPS)
# SSL_KEY_PATH=/path/to/private-key.pem
# SSL_CERT_PATH=/path/to/certificate.pem

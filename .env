# Frontend Environment Variables for PayRoll Management System
# These variables are prefixed with VITE_ to be accessible in the frontend

# API Base URL (backend server URL)
VITE_API_BASE_URL=http://localhost:5000

# Backend port (fallback when VITE_API_BASE_URL is not set)
VITE_BACKEND_PORT=5000

# Frontend development port
VITE_PORT=3000

# Application title
VITE_APP_TITLE=PayRoll Management System

# API timeout in milliseconds
VITE_API_TIMEOUT=10000

# Enable/disable debug mode
VITE_DEBUG_MODE=true
